@{
    ViewBag.Title = "Find your next opportunity";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="page-wrap">
    <section class="browse-intro">
        <div>
            <span class="eyebrow">YOUR NEXT CHAPTER STARTS HERE</span>
            <h1>Find work that <span>works for you.</span></h1>
            <p class="intro-copy">Discover opportunities, meet great teams, and take your next step.</p>
        </div>
        <div class="intro-side">
            <strong>A more thoughtful job search.</strong>
            <p>Explore roles that match your experience and make your next move with confidence.</p>
        </div>
    </section>

    @using (Html.BeginForm("SearchJobs_Pageload", "JobSeeker", FormMethod.Get, new { @class = "search-bar", role = "search" }))
    {
        <label class="search-field" for="home-job-title">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
            @Html.TextBox("jobTitle", null, new { id = "home-job-title", placeholder = "Job title, keyword, or company", aria_label = "Job title, keyword, or company" })
        </label>
        <label class="search-field" for="home-job-location">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>
            @Html.TextBox("location", null, new { id = "home-job-location", placeholder = "City, region, or anywhere", aria_label = "Location" })
        </label>
        <button type="submit" class="jf-button">
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
            Search Jobs
        </button>
    }

    <div class="popular-searches">
        <span>Popular searches:</span>
        @Html.ActionLink("Product Designer", "SearchJobs_Pageload", "JobSeeker", new { jobTitle = "Product Designer" }, null)
        @Html.ActionLink("Frontend Engineer", "SearchJobs_Pageload", "JobSeeker", new { jobTitle = "Frontend Engineer" }, null)
        @Html.ActionLink("Marketing", "SearchJobs_Pageload", "JobSeeker", new { jobTitle = "Marketing" }, null)
        @Html.ActionLink("Remote", "SearchJobs_Pageload", "JobSeeker", new { location = "Remote" }, null)
    </div>

    <section class="home-opportunities">
        <div class="results-header">
            <div><span class="eyebrow">A GOOD PLACE TO BEGIN</span><h2>Explore opportunities</h2></div>
            @Html.ActionLink("Sign in to find jobs", "Login_Pageload", "Login", null, new { @class = "jf-button-outline" })
        </div>
        <div class="home-empty-row">
            <div class="home-empty-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="7" width="18" height="14" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 12h18"/></svg>
            </div>
            <div><h3>Start with a search that fits you.</h3><p>Sign in as a Job Seeker to browse current listings and narrow them by experience, salary, and location.</p></div>
            @Html.ActionLink("Create a Job Seeker account", "Insert_Pageload", "JobSeekerReg", null, new { @class = "jf-button" })
        </div>
    </section>

    <section class="home-career">
        <img src="@Url.Content("~/Content/workspace.jpg")" alt="A calm, bright workspace" loading="lazy" />
        <div><span class="eyebrow">YOUR NEXT CHAPTER</span><h2>Give your experience a place to shine.</h2><p>Create your Job Seeker account to keep your profile and resume ready as you explore opportunities.</p>@Html.ActionLink("Get started", "Insert_Pageload", "JobSeekerReg", null, new { @class = "jf-button" })</div>
    </section>
</main>
