@{
    ViewBag.Title = "Admin Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="admin-page">
    <div class="admin-shell">
        <aside class="admin-sidebar" aria-label="Admin navigation">
            <h2>Job Finder Admin</h2>
            <ul class="admin-nav">
                <li>@Html.ActionLink("Dashboard", "Dashboard_Pageload", "Admin", null, new { @class = "active", aria_current = "page" })</li>
                <li>@Html.ActionLink("Manage Job Seekers", "ManageJobseekers_Pageload", "Admin")</li>
                <li>@Html.ActionLink("Manage Employers", "ManageEmployers_Pageload", "Admin")</li>
                <li>@Html.ActionLink("Manage Jobs", "ManageJobs_Pageload", "Admin")</li>
            </ul>
            @using (Html.BeginForm("Logout", "Admin", FormMethod.Post, new { @class = "admin-logout-form" }))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="admin-logout">Logout</button>
            }
        </aside>

        <section class="admin-content">
            <h1>Admin Dashboard</h1>
            <p class="admin-muted">Review the Job Finder directory using the management pages below.</p>
            <h2>Quick links</h2>
            <div class="admin-quick-links">
                <a class="admin-card" href="@Url.Action("ManageJobseekers_Pageload", "Admin")">
                    <h2>Manage Job Seekers</h2><span class="admin-muted">Browse registered Job Seeker records.</span>
                </a>
                <a class="admin-card" href="@Url.Action("ManageEmployers_Pageload", "Admin")">
                    <h2>Manage Employers</h2><span class="admin-muted">Browse registered Employer records.</span>
                </a>
                <a class="admin-card" href="@Url.Action("ManageJobs_Pageload", "Admin")">
                    <h2>Manage Jobs</h2><span class="admin-muted">Review jobs posted in the directory.</span>
                </a>
            </div>
        </section>
    </div>
</main>
