@{
    ViewBag.Title = "Admin Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .admin-page { --cream: #fbf5ed; --coral: #e87562; --ink: #292521; --line: #ded3c7; color: var(--ink); background: var(--cream); border: 1px solid var(--line); border-radius: 12px; padding: 24px; margin: 18px 0; }
    .admin-shell { display: grid; grid-template-columns: 230px minmax(0, 1fr); gap: 24px; }
    .admin-sidebar { background: #fffdf9; border: 1px solid var(--line); border-radius: 10px; padding: 18px; }
    .admin-sidebar h2 { font-size: 18px; margin: 2px 0 16px; }
    .admin-nav { list-style: none; padding: 0; margin: 0; }
    .admin-nav li { margin: 5px 0; }
    .admin-nav a, .admin-logout { display: block; padding: 10px 12px; border-radius: 7px; color: var(--ink); text-decoration: none; }
    .admin-nav a:hover, .admin-nav a.active { background: #f5e7db; text-decoration: none; }
    .admin-logout { width: 100%; border: 0; background: var(--coral); color: #fff; text-align: left; margin-top: 6px; }
    .admin-logout:hover, .admin-button:hover { background: #d85f4d; color: #fff; text-decoration: none; }
    .admin-content { min-width: 0; }
    .admin-content h1 { margin-top: 5px; font-weight: 700; }
    .admin-muted { color: #6b625a; }
    .admin-quick-links { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-top: 28px; }
    .admin-card { display: block; height: 100%; padding: 20px; background: #fffdf9; border: 1px solid var(--line); border-radius: 10px; color: var(--ink); text-decoration: none; }
    .admin-card:hover { border-color: var(--coral); text-decoration: none; color: var(--ink); box-shadow: 0 4px 14px rgba(41,37,33,.07); }
    .admin-card h2 { font-size: 19px; margin: 0 0 9px; }
    .admin-button { display: inline-block; background: var(--coral); color: #fff; border-radius: 6px; padding: 10px 14px; text-decoration: none; }
    @@media (max-width: 767px) { .admin-page { padding: 15px; } .admin-shell { grid-template-columns: 1fr; gap: 16px; } .admin-quick-links { grid-template-columns: 1fr; } }
</style>

<main class="admin-page">
    <div class="admin-shell">
        <aside class="admin-sidebar" aria-label="Admin navigation">
            <h2>Job Finder Admin</h2>
            <ul class="admin-nav">
                <li>@Html.ActionLink("Dashboard", "Dashboard_Pageload", "Admin", null, new { @class = "active", aria_current = "page" })</li>
                <li>@Html.ActionLink("Manage Job Seekers", "ManageJobseekers_Pageload", "Admin")</li>
                <li>@Html.ActionLink("Manage Employers", "ManageEmployers_Pageload", "Admin")</li>
                <li>@Html.ActionLink("Manage Jobs", "ManageJobs_Pageload", "Admin")</li>
            </ul>
            @using (Html.BeginForm("Logout", "Admin", FormMethod.Post, new { @class = "admin-logout-form" }))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="admin-logout">Logout</button>
            }
        </aside>

        <section class="admin-content">
            <h1>Admin Dashboard</h1>
            <p class="admin-muted">Review the Job Finder directory using the management pages below.</p>
            <h2>Quick links</h2>
            <div class="admin-quick-links">
                <a class="admin-card" href="@Url.Action("ManageJobseekers_Pageload", "Admin")">
                    <h2>Manage Job Seekers</h2><span class="admin-muted">Browse registered Job Seeker records.</span>
                </a>
                <a class="admin-card" href="@Url.Action("ManageEmployers_Pageload", "Admin")">
                    <h2>Manage Employers</h2><span class="admin-muted">Browse registered Employer records.</span>
                </a>
                <a class="admin-card" href="@Url.Action("ManageJobs_Pageload", "Admin")">
                    <h2>Manage Jobs</h2><span class="admin-muted">Review jobs posted in the directory.</span>
                </a>
            </div>
        </section>
    </div>
</main>
