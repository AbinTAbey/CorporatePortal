
@model IEnumerable<CorporatePortal.Models.Job>
@using System.Linq
@{
    ViewBag.Title = "Manage Jobs";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<main class="admin-page"><div class="admin-shell">
    <aside class="admin-sidebar" aria-label="Admin navigation">
        <h2>Job Finder Admin</h2><ul class="admin-nav">
            <li>@Html.ActionLink("Dashboard", "Dashboard_Pageload", "Admin")</li>
            <li>@Html.ActionLink("Manage Job Seekers", "ManageJobseekers_Pageload", "Admin")</li>
            <li>@Html.ActionLink("Manage Employers", "ManageEmployers_Pageload", "Admin")</li>
            <li>@Html.ActionLink("Manage Jobs", "ManageJobs_Pageload", "Admin", null, new { @class = "active", aria_current = "page" })</li>
        </ul>
        @using (Html.BeginForm("Logout", "Admin", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <button type="submit" class="admin-logout">Logout</button>
        }
    </aside>
    <section class="admin-content"><h1>Manage Jobs</h1>
        @Html.ActionLink("Back to Dashboard", "Dashboard_Pageload", "Admin", null, new { @class = "admin-button" })
        @if (Model == null || !Model.Any())
        {
            <div class="admin-empty">There are no jobs to display yet.</div>
        }
        else
        {
            <div class="admin-table-wrap">
                <table class="table table-striped admin-table">
                    <thead><tr><th scope="col">Job ID</th><th scope="col">Job Title</th><th scope="col">Job Mode</th><th scope="col">Location</th><th scope="col">Experience Required</th><th scope="col">Salary Range</th><th scope="col">Actions</th></tr></thead>
                    <tbody>
                    @foreach (var job in Model)
                    {
                        <tr><td>@job.JobId</td><td>@job.JobTitle</td><td>@job.JobType</td><td>@job.Location</td><td>@job.ExperienceRequired</td><td>@job.SalaryRange</td><td>
                            @using (Html.BeginForm("DeleteJob", "Admin", new { id = job.JobId }, FormMethod.Post, new { onsubmit = "return confirm('Delete this job and its applications?');" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                            }
                        </td></tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div></main>

