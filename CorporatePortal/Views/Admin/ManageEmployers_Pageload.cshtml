
@model IEnumerable<CorporatePortal.Models.Employer>
@using System.Linq
@{
    ViewBag.Title = "Manage Employers";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<main class="admin-page"><div class="admin-shell">
    <aside class="admin-sidebar" aria-label="Admin navigation">
        <h2>Job Finder Admin</h2><ul class="admin-nav">
            <li>@Html.ActionLink("Dashboard", "Dashboard_Pageload", "Admin")</li>
            <li>@Html.ActionLink("Manage Job Seekers", "ManageJobseekers_Pageload", "Admin")</li>
            <li>@Html.ActionLink("Manage Employers", "ManageEmployers_Pageload", "Admin", null, new { @class = "active", aria_current = "page" })</li>
            <li>@Html.ActionLink("Manage Jobs", "ManageJobs_Pageload", "Admin")</li>
        </ul>
        @using (Html.BeginForm("Logout", "Admin", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <button type="submit" class="admin-logout">Logout</button>
        }
    </aside>
    <section class="admin-content"><h1>Manage Employers</h1>
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        @Html.ActionLink("Back to Dashboard", "Dashboard_Pageload", "Admin", null, new { @class = "admin-button" })
        @if (Model == null || !Model.Any())
        {
            <div class="admin-empty">There are no Employer records to display yet.</div>
        }
        else
        {
            <div class="admin-table-wrap">
                <table class="table table-striped admin-table">
                    <thead><tr><th scope="col">Employer ID</th><th scope="col">Name</th><th scope="col">Email</th><th scope="col">Phone</th><th scope="col">Actions</th></tr></thead>
                    <tbody>
                    @foreach (var employer in Model)
                    {
                        <tr>
                            <td>@employer.EmployerId</td><td>@employer.Name</td><td>@employer.Email</td><td>@employer.Phone</td>
                            <td>
                                @using (Html.BeginForm("DeleteEmployer", "Admin", new { id = employer.EmployerId }, FormMethod.Post, new { onsubmit = "return confirm('Delete this employer? Their company details and jobs will also be deleted.');" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div></main>

