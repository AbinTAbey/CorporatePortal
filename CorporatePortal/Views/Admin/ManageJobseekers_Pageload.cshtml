
@model IEnumerable<CorporatePortal.Models.Jobseeker>
@using System.Linq
@{
    ViewBag.Title = "Manage Job Seekers";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<main class="admin-page"><div class="admin-shell">
    <aside class="admin-sidebar" aria-label="Admin navigation">
        <h2>Job Finder Admin</h2><ul class="admin-nav">
            <li>@Html.ActionLink("Dashboard", "Dashboard_Pageload", "Admin")</li>
            <li>@Html.ActionLink("Manage Job Seekers", "ManageJobseekers_Pageload", "Admin", null, new { @class = "active", aria_current = "page" })</li>
            <li>@Html.ActionLink("Manage Employers", "ManageEmployers_Pageload", "Admin")</li>
            <li>@Html.ActionLink("Manage Jobs", "ManageJobs_Pageload", "Admin")</li>
        </ul>
        @using (Html.BeginForm("Logout", "Admin", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <button type="submit" class="admin-logout">Logout</button>
        }
    </aside>
    <section class="admin-content"><h1>Manage Job Seekers</h1>
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        @Html.ActionLink("Back to Dashboard", "Dashboard_Pageload", "Admin", null, new { @class = "admin-button" })
        @if (Model == null || !Model.Any())
        {
            <div class="admin-empty">There are no Job Seeker records to display yet.</div>
        }
        else
        {
            <div class="admin-table-wrap">
                <table class="table table-striped admin-table">
                    <thead><tr><th scope="col">Jobseeker ID</th><th scope="col">Name</th><th scope="col">Email</th><th scope="col">Phone</th><th scope="col">Actions</th></tr></thead>
                    <tbody>
                    @foreach (var seeker in Model)
                    {
                        <tr>
                            <td>@seeker.JobseekerId</td><td>@seeker.Name</td><td>@seeker.Email</td><td>@seeker.Phone</td>
                            <td>
                                @using (Html.BeginForm("DeleteJobseeker", "Admin", new { id = seeker.JobseekerId }, FormMethod.Post, new { onsubmit = "return confirm('Are you sure you want to delete this job seeker and their associated records?');" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div></main>

