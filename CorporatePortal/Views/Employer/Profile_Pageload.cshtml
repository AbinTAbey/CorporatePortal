@model CorporatePortal.Models.EmployerProfileViewModel
@{
    ViewBag.Title = "Company Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="page-wrap">
    <div class="dashboard-shell">
        <nav class="dashboard-nav" aria-label="Employer workspace">
            <p class="dashboard-nav-title">For Employers</p>
            @Html.ActionLink("Dashboard", "Dashboard_Pageload", "Employer")
            @Html.ActionLink("Post a Job", "PostJob_Pageload", "Employer")
            @Html.ActionLink("Manage Jobs", "ManageJobs_Pageload", "Employer")
            @Html.ActionLink("Applications", "Applications_Pageload", "Employer")
            @Html.ActionLink("Profile", "Profile_Pageload", "Employer", null, new { @class = "active", aria_current = "page" })
        </nav>
        <section class="dashboard-main">
            <div class="dashboard-heading"><div><span class="eyebrow">FOR EMPLOYERS</span><h1>Company Profile</h1><p>Keep your company information current for candidates.</p></div></div>
            @if (TempData["Success"] != null)
            {
                <div class="success-message" role="status">@TempData["Success"]</div>
            }
            <section class="content-panel">
                <div class="profile-contact"><strong>@Model.Name</strong><span>@Model.Email</span><span>@Model.Phone</span></div>
                @using (Html.BeginForm("UpdateProfile", "Employer", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(false, "Please correct the errors below.", new { @class = "validation-summary-errors" })
                    <div class="form-grid">
                        <div class="field">@Html.LabelFor(m => m.CompanyName)@Html.TextBoxFor(m => m.CompanyName, new { @class = "form-control" })@Html.ValidationMessageFor(m => m.CompanyName, "", new { @class = "field-validation-error" })</div>
                        <div class="field">@Html.LabelFor(m => m.Website)@Html.TextBoxFor(m => m.Website, new { @class = "form-control", type = "url", placeholder = "https://example.com" })@Html.ValidationMessageFor(m => m.Website, "", new { @class = "field-validation-error" })</div>
                        <div class="field full-width">@Html.LabelFor(m => m.Address)@Html.TextAreaFor(m => m.Address, new { @class = "form-control", rows = "3" })@Html.ValidationMessageFor(m => m.Address, "", new { @class = "field-validation-error" })</div>
                        <div class="field full-width">@Html.LabelFor(m => m.Description)@Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = "5" })@Html.ValidationMessageFor(m => m.Description, "", new { @class = "field-validation-error" })</div>
                    </div>
                    <div class="form-actions"><button type="submit" class="jf-button">Save Company Profile</button></div>
                }
            </section>
        </section>
    </div>
</main>
