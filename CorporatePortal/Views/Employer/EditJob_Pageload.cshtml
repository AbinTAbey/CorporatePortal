@model CorporatePortal.Models.JobFormViewModel
@{
    ViewBag.Title = "Edit Job";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="page-wrap">
    <div class="dashboard-shell">
        <nav class="dashboard-nav" aria-label="Employer workspace"><p class="dashboard-nav-title">For Employers</p>
            @Html.ActionLink("Overview", "Dashboard_Pageload", "Employer")
            @Html.ActionLink("Post a Job", "PostJob_Pageload", "Employer")
            @Html.ActionLink("Manage Jobs", "ManageJobs_Pageload", "Employer", null, new { @class = "active", aria_current = "page" })
            @Html.ActionLink("Applications", "Applications_Pageload", "Employer")
            @Html.ActionLink("Company Profile", "Profile_Pageload", "Employer")
        </nav>
        <section class="dashboard-main">
            <div class="dashboard-heading"><div><span class="eyebrow">FOR EMPLOYERS</span><h1>Edit Job</h1><p>Update the details for this listing.</p></div></div>
            <section class="content-panel">
                @using (Html.BeginForm("EditJob_Pageload", "Employer", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.JobId)
                    @Html.ValidationSummary(false, "", new { @class = "validation-summary-errors" })
                    <div class="form-grid">
                        <div class="field">@Html.LabelFor(m => m.JobTitle, "Job Title")@Html.TextBoxFor(m => m.JobTitle, new { @class = "form-control" })@Html.ValidationMessageFor(m => m.JobTitle, "", new { @class = "field-validation-error" })</div>
                        <div class="field">
                            @Html.LabelFor(m => m.JobType, "Job Mode")
                            @if (ViewBag.LegacyJobMode != null)
                            {
                                <p class="field-hint">This job has the legacy value “@ViewBag.LegacyJobMode”. Select a new mode to save this edit.</p>
                            }
                            @Html.DropDownListFor(m => m.JobType, new SelectList(new[] { "Hybrid", "On-site", "Remote" }, Model.JobType), "Select a job mode", new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.JobType, "", new { @class = "field-validation-error" })
                        </div>
                        <div class="field">@Html.LabelFor(m => m.ExperienceRequired, "Experience Required")@Html.TextBoxFor(m => m.ExperienceRequired, new { @class = "form-control" })@Html.ValidationMessageFor(m => m.ExperienceRequired, "", new { @class = "field-validation-error" })</div>
                        <div class="field">@Html.LabelFor(m => m.Location)@Html.TextBoxFor(m => m.Location, new { @class = "form-control" })@Html.ValidationMessageFor(m => m.Location, "", new { @class = "field-validation-error" })</div>
                        <div class="field">@Html.LabelFor(m => m.SalaryRange, "Salary Range")@Html.TextBoxFor(m => m.SalaryRange, new { @class = "form-control" })@Html.ValidationMessageFor(m => m.SalaryRange, "", new { @class = "field-validation-error" })</div>
                        <div class="field full-width">@Html.LabelFor(m => m.RequiredSkills, "Required Skills")@Html.TextAreaFor(m => m.RequiredSkills, new { @class = "form-control", rows = "3" })@Html.ValidationMessageFor(m => m.RequiredSkills, "", new { @class = "field-validation-error" })</div>
                        <div class="field full-width">@Html.LabelFor(m => m.JobDescription, "Job Description")@Html.TextAreaFor(m => m.JobDescription, new { @class = "form-control", rows = "6" })@Html.ValidationMessageFor(m => m.JobDescription, "", new { @class = "field-validation-error" })</div>
                    </div>
                    <div class="form-actions"><button type="submit" class="jf-button">Save Changes</button>@Html.ActionLink("Cancel", "ManageJobs_Pageload", "Employer", null, new { @class = "jf-button-outline" })</div>
                }
            </section>
        </section>
    </div>
</main>
