@model IEnumerable<CorporatePortal.Models.sp_GetEmployerJobs_Result>
@using System.Linq
@{
    ViewBag.Title = "Manage Jobs";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var jobs = Model == null ? new List<CorporatePortal.Models.sp_GetEmployerJobs_Result>() : Model.ToList();
}

<main class="page-wrap">
    <div class="dashboard-shell">
        <nav class="dashboard-nav" aria-label="Employer workspace"><p class="dashboard-nav-title">For Employers</p>
            @Html.ActionLink("Overview", "Dashboard_Pageload", "Employer")
            @Html.ActionLink("Post a Job", "PostJob_Pageload", "Employer")
            @Html.ActionLink("Manage Jobs", "ManageJobs_Pageload", "Employer", null, new { @class = "active", aria_current = "page" })
            @Html.ActionLink("Applications", "Applications_Pageload", "Employer")
            @Html.ActionLink("Company Profile", "Profile_Pageload", "Employer")
        </nav>
        <section class="dashboard-main">
            <div class="dashboard-heading"><div><span class="eyebrow">FOR EMPLOYERS</span><h1>Manage Jobs</h1><p>Review and update listings associated with your account.</p></div>@Html.ActionLink("Post a Job", "PostJob_Pageload", "Employer", null, new { @class = "jf-button" })</div>
            @if (TempData["Success"] != null)
            {
                <div class="success-message" role="status">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
            }
            @if (!jobs.Any())
            {
                <div class="empty-state"><h3>No job listings yet</h3><p>Post your first opportunity to help candidates find your team.</p>@Html.ActionLink("Post a Job", "PostJob_Pageload", "Employer", null, new { @class = "jf-button" })</div>
            }
            else
            {
                <div class="table-wrap"><table>
                    <thead><tr><th>Job ID</th><th>Role</th><th>Company</th><th>Job Mode</th><th>Location</th><th>Experience</th><th>Salary Range</th><th>Actions</th></tr></thead>
                    <tbody>
                    @foreach (var job in jobs)
                    {
                        <tr>
                            <td>@job.JobId</td><td><strong>@job.JobTitle</strong></td><td>@job.CompanyName</td><td>@job.JobType</td><td>@job.Location</td><td>@job.ExperienceRequired</td><td>@job.SalaryRange</td>
                            <td><div class="table-actions">
                                @Html.ActionLink("Edit", "EditJob_Pageload", "Employer", new { id = job.JobId }, new { @class = "jf-button-outline" })
                                @using (Html.BeginForm("DeleteJob", "Employer", new { id = job.JobId }, FormMethod.Post, new { onsubmit = "return confirm('Delete this job listing?');" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger">Delete</button>
                                }
                            </div></td>
                        </tr>
                    }
                    </tbody>
                </table></div>
            }
        </section>
    </div>
</main>
