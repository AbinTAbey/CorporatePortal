
@{
    ViewBag.Title = "Employer Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .finder-page { --cream:#fbf5ed; --coral:#e87562; --ink:#292521; --line:#ded3c7; color:var(--ink); background:var(--cream); border:1px solid var(--line); border-radius:12px; padding:24px; margin:18px 0; }
    .finder-shell { display:grid; grid-template-columns:230px minmax(0,1fr); gap:24px; }
    .finder-sidebar,.finder-card,.finder-panel { background:#fffdf9; border:1px solid var(--line); border-radius:10px; }
    .finder-sidebar { padding:18px; } .finder-sidebar h2 { font-size:18px; margin:2px 0 16px; }
    .finder-nav { list-style:none; padding:0; margin:0; } .finder-nav li { margin:5px 0; }
    .finder-nav a,.finder-logout { display:block; padding:10px 12px; border-radius:7px; color:var(--ink); text-decoration:none; }
    .finder-nav a:hover,.finder-nav a.active { background:#f5e7db; text-decoration:none; }
    .finder-logout,.finder-button { background:var(--coral); color:#fff; border:0; border-radius:6px; padding:10px 14px; }
    .finder-logout { width:100%; text-align:left; margin-top:6px; } .finder-button:hover,.finder-logout:hover { background:#d85f4d; color:#fff; }
    .finder-content { min-width:0; } .finder-content h1 { margin:5px 0 12px; font-weight:700; }
    .finder-links { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16px; margin-top:26px; }
    .finder-card { display:block; padding:20px; color:var(--ink); text-decoration:none; }
    .finder-card:hover { border-color:var(--coral); color:var(--ink); text-decoration:none; box-shadow:0 4px 14px rgba(41,37,33,.07); }
    .finder-card h2 { font-size:19px; margin:0 0 8px; } .finder-muted { color:#6b625a; }
    @@media(max-width:767px) { .finder-page{padding:15px;} .finder-shell{grid-template-columns:1fr;gap:16px;} .finder-links{grid-template-columns:1fr;} }
</style>
<main class="finder-page"><div class="finder-shell">
    <aside class="finder-sidebar" aria-label="Employer navigation">
        <h2>Job Finder</h2><ul class="finder-nav">
            <li>@Html.ActionLink("Dashboard", "Dashboard_Pageload", "Employer", null, new { @class="active", aria_current="page" })</li>
            <li>@Html.ActionLink("Post Job", "PostJob_Pageload", "Employer")</li>
            <li>@Html.ActionLink("Manage Jobs", "ManageJobs_Pageload", "Employer")</li>
            <li>@Html.ActionLink("Profile", "Profile_Pageload", "Employer")</li>
        </ul>
        @using (Html.BeginForm("Logout", "Employer", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <button type="submit" class="finder-logout">Logout</button>
        }
    </aside>
    <section class="finder-content">
        <h1>Employer Dashboard</h1>
        <p class="finder-muted">Manage your job posts and company profile from one place.</p>
        <div class="finder-links">
            <a class="finder-card" href="@Url.Action("PostJob_Pageload", "Employer")"><h2>Post a Job</h2><span class="finder-muted">Create a new job listing.</span></a>
            <a class="finder-card" href="@Url.Action("ManageJobs_Pageload", "Employer")"><h2>Manage Jobs</h2><span class="finder-muted">Review and update your listings.</span></a>
            <a class="finder-card" href="@Url.Action("Profile_Pageload", "Employer")"><h2>Company Profile</h2><span class="finder-muted">Keep your company information current.</span></a>
        </div>
    </section>
</div></main>

