@{
    ViewBag.Title = "Employer Workspace";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="page-wrap">
    <div class="dashboard-shell">
        <nav class="dashboard-nav" aria-label="Employer workspace">
            <p class="dashboard-nav-title">For Employers</p>
            @Html.ActionLink("Overview", "Dashboard_Pageload", "Employer", null, new { @class = "active", aria_current = "page" })
            @Html.ActionLink("Post a Job", "PostJob_Pageload", "Employer")
            @Html.ActionLink("Manage Jobs", "ManageJobs_Pageload", "Employer")
            @Html.ActionLink("Applications", "Applications_Pageload", "Employer")
            @Html.ActionLink("Company Profile", "Profile_Pageload", "Employer")
        </nav>
        <section class="dashboard-main">
            <div class="dashboard-heading">
                <div><span class="eyebrow">GREAT WORK STARTS WITH GREAT PEOPLE</span><h1>Build your next great team.</h1><p>A thoughtful space for your next hire and company profile.</p></div>
                @Html.ActionLink("Post a Job", "PostJob_Pageload", "Employer", null, new { @class = "jf-button" })
            </div>
            @if (TempData["Success"] != null)
            {
                <div class="success-message" role="status">@TempData["Success"]</div>
            }
            <div class="dashboard-cards">
                <article class="dashboard-card"><h2>Post your next role</h2><p>Share the title, requirements, location, and salary range with candidates.</p></article>
                <article class="dashboard-card"><h2>Manage your listings</h2><p>Review, edit, or remove jobs posted by your employer account.</p></article>
                <article class="dashboard-card"><h2>Company profile</h2><p>Keep your company name, website, address, and description current.</p></article>
            </div>
            <h2 class="dashboard-section-title">Your hiring workspace</h2>
            <div class="dashboard-links">
                <a class="dashboard-link" href="@Url.Action("ManageJobs_Pageload", "Employer")"><strong>Manage posted jobs</strong><span>Review and update your current listings.</span></a>
                <a class="dashboard-link" href="@Url.Action("Applications_Pageload", "Employer")"><strong>View applications</strong><span>Review applications submitted for your jobs.</span></a>
                <a class="dashboard-link" href="@Url.Action("Profile_Pageload", "Employer")"><strong>Update company profile</strong><span>Share the details candidates need to know.</span></a>
            </div>
        </section>
    </div>
</main>
