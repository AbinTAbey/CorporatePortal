@model CorporatePortal.Models.RegisterViewModel
@{
    ViewBag.Title = "Create an Employer account";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="auth-page auth-register">
    <div class="page-intro">
        <span class="eyebrow">GREAT WORK STARTS WITH GREAT PEOPLE</span>
        <h1>Build your next great team.</h1>
        <p>Create an employer account to hire talent.</p>
    </div>
    <section class="content-panel">
        @if (TempData["Success"] != null)
        {
            <div class="success-message registration-success" role="status">
                <strong>@TempData["Success"]</strong>
                <span>Redirecting to Login in 3 seconds...</span>
            </div>
            <script>
                window.setTimeout(function () {
                    window.location.href = '@Url.Action("Login_Pageload", "Login")';
                }, 3000);
            </script>
        }
        @Html.ValidationSummary(false, "", new { @class = "validation-summary-errors" })
        @using (Html.BeginForm("Insert_Pageload", "employerReg", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div class="field">
                @Html.LabelFor(m => m.Name)
                @Html.TextBoxFor(m => m.Name, new { @class = "form-control", autocomplete = "name", placeholder = "Your full name" })
                @Html.ValidationMessageFor(m => m.Name, "", new { @class = "field-validation-error" })
            </div>
            <div class="field">
                @Html.LabelFor(m => m.Email)
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", autocomplete = "email", placeholder = "you@example.com" })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "field-validation-error" })
            </div>
            <div class="field">
                @Html.LabelFor(m => m.Phone)
                @Html.TextBoxFor(m => m.Phone, new { @class = "form-control", type = "tel", autocomplete = "tel", placeholder = "Phone number" })
                @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "field-validation-error" })
            </div>
            <div class="field">
                @Html.LabelFor(m => m.Username)
                @Html.TextBoxFor(m => m.Username, new { @class = "form-control", autocomplete = "username", placeholder = "Choose a username" })
                @Html.ValidationMessageFor(m => m.Username, "", new { @class = "field-validation-error" })
            </div>
            <div class="field">
                @Html.LabelFor(m => m.Password)
                @Html.PasswordFor(m => m.Password, new { @class = "form-control", autocomplete = "new-password", placeholder = "At least 8 characters" })
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "field-validation-error" })
            </div>
            <div class="field">
                @Html.LabelFor(m => m.ConfirmPassword)
                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", autocomplete = "new-password", placeholder = "Enter your password again" })
                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "field-validation-error" })
            </div>
            <div class="form-actions"><button type="submit" class="jf-button auth-submit">Create Employer Account <span aria-hidden="true">→</span></button></div>
        }
        <div class="auth-links">
            Already have an account? @Html.ActionLink("Sign in", "Login_Pageload", "Login")<br />
            Looking for work? @Html.ActionLink("Register as a Job Seeker", "Insert_Pageload", "JobSeekerReg")
        </div>
    </section>
</main>
