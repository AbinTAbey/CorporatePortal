@model CorporatePortal.Models.JobseekerProfileViewModel
@{
    ViewBag.Title = "My Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="page-wrap">
    <div class="dashboard-shell">
        <nav class="dashboard-nav" aria-label="Job Seeker workspace">
            <p class="dashboard-nav-title">My Career</p>
            @Html.ActionLink("Overview", "Dashboard_Pageload", "JobSeeker")
            @Html.ActionLink("Search Jobs", "SearchJobs_Pageload", "JobSeeker")
            @Html.ActionLink("Profile", "Profile_Pageload", "JobSeeker", null, new { @class = "active", aria_current = "page" })
        </nav>
        <section class="dashboard-main">
            <div class="dashboard-heading"><div><span class="eyebrow">YOUR CAREER, YOUR WAY</span><h1>My Profile</h1><p>Keep your experience and resume ready to share.</p></div></div>
            @if (TempData["Success"] != null)
            {
                <div class="success-message" role="status">@TempData["Success"]</div>
            }
            <section class="content-panel">
                @using (Html.BeginForm("UpdateProfile", "JobSeeker", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(false, "", new { @class = "validation-summary-errors" })
                    <div class="account-summary"><div><h2>@Model.Name</h2><p>@Model.Email · @Model.Phone</p></div></div>
                    <div class="form-grid">
                        <label class="field">@Html.DisplayNameFor(m => m.Qualification)@Html.TextBoxFor(m => m.Qualification, new { @class = "form-control" })@Html.ValidationMessageFor(m => m.Qualification, "", new { @class = "field-validation-error" })</label>
                        <label class="field">@Html.DisplayNameFor(m => m.Experience)@Html.TextBoxFor(m => m.Experience, new { @class = "form-control", placeholder = "e.g. 3 years" })@Html.ValidationMessageFor(m => m.Experience, "", new { @class = "field-validation-error" })</label>
                        <label class="field full-width">@Html.DisplayNameFor(m => m.Skills)@Html.TextAreaFor(m => m.Skills, new { @class = "form-control", rows = "3" })@Html.ValidationMessageFor(m => m.Skills, "", new { @class = "field-validation-error" })</label>
                        <label class="field full-width">@Html.DisplayNameFor(m => m.Address)@Html.TextAreaFor(m => m.Address, new { @class = "form-control", rows = "3" })@Html.ValidationMessageFor(m => m.Address, "", new { @class = "field-validation-error" })</label>
                        <div class="field full-width">
                            @if (!string.IsNullOrWhiteSpace(Model.ResumePath))
                            {
                                <p class="resume-current">Current resume: <a href="@Url.Content(Model.ResumePath)" target="_blank" rel="noopener noreferrer">View uploaded resume</a></p>
                            }
                            <label for="ResumeFile">Replace resume (PDF, DOC, or DOCX; up to 5 MB)</label>
                            <input type="file" id="ResumeFile" name="ResumeFile" class="form-control" accept=".pdf,.doc,.docx" />
                            @Html.ValidationMessageFor(m => m.ResumeFile, "", new { @class = "field-validation-error" })
                        </div>
                    </div>
                    <div class="form-actions"><button type="submit" class="jf-button">Save Profile</button>@Html.ActionLink("Cancel", "Dashboard_Pageload", "JobSeeker", null, new { @class = "jf-button-outline" })</div>
                }
            </section>
        </section>
    </div>
</main>
