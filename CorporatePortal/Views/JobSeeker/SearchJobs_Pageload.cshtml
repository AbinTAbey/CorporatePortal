
@model IEnumerable<CorporatePortal.Models.sp_GetJobs_Result>
@using System.Linq
@{
    ViewBag.Title = "Search Jobs";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .finder-page { --cream:#fbf5ed; --coral:#e87562; --ink:#292521; --line:#ded3c7; color:var(--ink); background:var(--cream); border:1px solid var(--line); border-radius:12px; padding:24px; margin:18px 0; }
    .finder-shell { display:grid; grid-template-columns:230px minmax(0,1fr); gap:24px; } .finder-sidebar,.finder-panel,.finder-table-wrap,.finder-empty { background:#fffdf9; border:1px solid var(--line); border-radius:10px; }
    .finder-sidebar { padding:18px; } .finder-sidebar h2 { font-size:18px; margin:2px 0 16px; } .finder-nav { list-style:none; padding:0; margin:0; } .finder-nav li { margin:5px 0; }
    .finder-nav a,.finder-logout { display:block; padding:10px 12px; border-radius:7px; color:var(--ink); text-decoration:none; } .finder-nav a:hover,.finder-nav a.active { background:#f5e7db; text-decoration:none; }
    .finder-logout,.finder-button { background:var(--coral); color:#fff; border:0; border-radius:6px; padding:10px 14px; } .finder-logout { width:100%; text-align:left; margin-top:6px; } .finder-button:hover,.finder-logout:hover { background:#d85f4d; color:#fff; }
    .finder-content { min-width:0; } .finder-content h1 { margin:5px 0 18px; font-weight:700; } .finder-panel { padding:18px; margin-bottom:18px; }
    .finder-form { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; align-items:end; } .finder-form .form-group { margin:0; }
    .finder-form .form-control { max-width:none; min-height:40px; border-color:#cbb9a8; border-radius:7px; box-shadow:none; } .finder-actions { display:flex; gap:9px; flex-wrap:wrap; }
    .finder-table-wrap { overflow-x:auto; } .finder-table { margin:0; min-width:760px; color:var(--ink); } .finder-table thead { background:#f1e5d9; }
    .finder-table>thead>tr>th { border-bottom:2px solid #cbb9a8; } .finder-table>tbody>tr>td,.finder-table>thead>tr>th { border-color:var(--line); padding:12px; vertical-align:middle; }
    .finder-empty { padding:20px; border-style:dashed; color:#6b625a; }
    @@media(max-width:767px) { .finder-page{padding:15px;} .finder-shell{grid-template-columns:1fr;gap:16px;} .finder-form{grid-template-columns:1fr;} }
</style>
<main class="finder-page"><div class="finder-shell">
    <aside class="finder-sidebar" aria-label="Job Seeker navigation"><h2>Job Finder</h2><ul class="finder-nav">
        <li>@Html.ActionLink("Dashboard", "Dashboard_Pageload", "JobSeeker")</li><li>@Html.ActionLink("Search Jobs", "SearchJobs_Pageload", "JobSeeker", null, new { @class="active", aria_current="page" })</li>
        <li>@Html.ActionLink("Profile", "Profile_Pageload", "JobSeeker")</li>
    </ul>
    @using (Html.BeginForm("Logout", "JobSeeker", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <button type="submit" class="finder-logout">Logout</button>
    }
    </aside>
    <section class="finder-content"><h1>Search Jobs</h1>
        <div class="finder-panel">
            @using (Html.BeginForm("SearchJobs_Pageload", "JobSeeker", FormMethod.Get, new { @class="finder-form" }))
            {
                <div class="form-group"><label for="jobTitle">Job Title</label>@Html.TextBox("jobTitle", Request["jobTitle"], new { @class="form-control", id="jobTitle" })</div>
                <div class="form-group"><label for="experienceRequired">Experience</label>@Html.TextBox("experienceRequired", Request["experienceRequired"], new { @class="form-control", id="experienceRequired" })</div>
                <div class="form-group"><label for="salaryRange">Salary Range</label>@Html.TextBox("salaryRange", Request["salaryRange"], new { @class="form-control", id="salaryRange" })</div>
                <div class="form-group"><label for="location">Location</label>@Html.TextBox("location", Request["location"], new { @class="form-control", id="location" })</div>
                <div class="finder-actions"><button type="submit" class="finder-button">Search</button>@Html.ActionLink("Clear Filters", "SearchJobs_Pageload", "JobSeeker", null, new { @class="btn btn-default" })</div>
            }
        </div>
        @if (Model == null || !Model.Any())
        {
            <div class="finder-empty">No jobs matched your search. Try changing or clearing the filters.</div>
        }
        else
        {
            <div class="finder-table-wrap"><table class="table table-striped finder-table">
                <thead><tr><th>Job Title</th><th>Company</th><th>Location</th><th>Experience</th><th>Salary</th><th>Job Type</th><th>Details</th></tr></thead>
                <tbody>
                @foreach (var job in Model)
                {
                    <tr><td>@job.JobTitle</td><td>@job.CompanyName</td><td>@job.Location</td><td>@job.ExperienceRequired</td><td>@job.SalaryRange</td><td>@job.JobType</td>
                        <td>@Html.ActionLink("Details", "JobDetails_Pageload", "JobSeeker", new { id = job.JobId }, new { @class="btn btn-default btn-sm" })</td></tr>
                }
                </tbody>
            </table></div>
        }
    </section>
</div></main>

