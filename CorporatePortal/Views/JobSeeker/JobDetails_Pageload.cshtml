@model CorporatePortal.Models.sp_GetJobDetails_Result
@{
    ViewBag.Title = "Job Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var companyName = string.IsNullOrWhiteSpace(Model.CompanyName) ? "Company" : Model.CompanyName.Trim();
}

<main class="page-wrap">
    @Html.ActionLink("← All opportunities", "SearchJobs_Pageload", "JobSeeker", null, new { @class = "detail-back" })
    <div class="detail-layout">
        <article class="content-panel detail-main">
            <div class="detail-company"><div class="company-logo" aria-hidden="true">@companyName.Substring(0, 1).ToUpperInvariant()</div><strong>@companyName</strong></div>
            <h1>@Model.JobTitle</h1>
            <div class="job-location">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>
                @Model.Location
            </div>
            <div class="job-tags">
                @if (!string.IsNullOrWhiteSpace(Model.JobType)) { <span class="category-tag">@Model.JobType</span> }
                @if (!string.IsNullOrWhiteSpace(Model.ExperienceRequired)) { <span>@Model.ExperienceRequired</span> }
            </div>
            <h2>About the role</h2><p>@Model.JobDescription</p>
            <h2>Required skills</h2><p>@Model.RequiredSkills</p>
            @if (!string.IsNullOrWhiteSpace(Model.CompanyDescription))
            {
                <h2>About @companyName</h2><p>@Model.CompanyDescription</p>
            }
            @if (!string.IsNullOrWhiteSpace(Model.CompanyAddress))
            {
                <h2>Company location</h2><p>@Model.CompanyAddress</p>
            }
        </article>
        <aside class="content-panel detail-sidebar">
            <h2>The opportunity</h2>
            <div class="detail-stat"><span>Salary range</span><strong>@Model.SalaryRange</strong></div>
            <div class="detail-stat"><span>Job mode</span><strong>@Model.JobType</strong></div>
            <div class="detail-stat"><span>Experience</span><strong>@Model.ExperienceRequired</strong></div>
            @if (!string.IsNullOrWhiteSpace(Model.Website))
            {
                <div class="detail-stat"><span>Company website</span><strong>@Model.Website</strong></div>
            }
            <p class="resume-note">Use Apply Now to send your application for this opportunity.</p>
            @if (TempData["ApplicationSuccess"] != null)
            {
                <div class="success-message" role="status">@TempData["ApplicationSuccess"]</div>
            }
            @if (TempData["ApplicationError"] != null)
            {
                <div class="alert alert-danger" role="alert">@TempData["ApplicationError"]</div>
            }
            @if (TempData["JobStateMessage"] != null)
            {
                <div class="success-message" role="status">@TempData["JobStateMessage"]</div>
            }
            @if (TempData["JobStateError"] != null)
            {
                <div class="alert alert-danger" role="alert">@TempData["JobStateError"]</div>
            }
            @if (ViewBag.IsArchived == true)
            {
                <div class="application-status">Archived in My Jobs</div>
                using (Html.BeginForm("RestoreJob", "JobSeeker", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.Hidden("id", Model.JobId)
                    @Html.Hidden("source", "Details")
                    <button type="submit" class="jf-button-outline">Restore to My Jobs</button>
                }
            }
            @if (ViewBag.IsSaved == true)
            {
                using (Html.BeginForm("RemoveSavedJob", "JobSeeker", FormMethod.Post, new { @class = "job-save-form" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.Hidden("id", Model.JobId)
                    @Html.Hidden("source", "Details")
                    <button type="submit" class="jf-button-outline">Remove from Saved</button>
                }
            }
            else if (ViewBag.IsArchived != true)
            {
                using (Html.BeginForm("SaveJob", "JobSeeker", FormMethod.Post, new { @class = "job-save-form" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.Hidden("id", Model.JobId)
                    @Html.Hidden("source", "Details")
                    <button type="submit" class="jf-button-outline">Save Job</button>
                }
            }
            @if (ViewBag.HasApplied == true)
            {
                <div class="application-status application-status-applied" role="status">Already Applied</div>
            }
            else
            {
                using (Html.BeginForm("ApplyForJob", "JobSeeker", new { id = Model.JobId }, FormMethod.Post, new { @class = "apply-form" }))
                {
                    @Html.AntiForgeryToken()
                    <label for="cover-letter">Cover letter <span>(optional)</span></label>
                    <textarea id="cover-letter" name="coverLetter" rows="5" maxlength="2000" placeholder="Add a short note for the employer"></textarea>
                    <button type="submit" class="jf-button apply-button">Apply Now</button>
                }
            }
        </aside>
    </div>
</main>
