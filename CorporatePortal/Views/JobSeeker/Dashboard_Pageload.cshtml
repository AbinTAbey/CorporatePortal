@{
    ViewBag.Title = "My Career";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="page-wrap">
    <div class="dashboard-shell">
        <nav class="dashboard-nav" aria-label="Job Seeker workspace">
            <p class="dashboard-nav-title">My Career</p>
            @Html.ActionLink("Overview", "Dashboard_Pageload", "JobSeeker", null, new { @class = "active", aria_current = "page" })
            @Html.ActionLink("Search Jobs", "SearchJobs_Pageload", "JobSeeker")
            @Html.ActionLink("My Jobs", "MyJobs_Pageload", "JobSeeker")
            @Html.ActionLink("My Applications", "MyApplications_Pageload", "JobSeeker")
            @Html.ActionLink("Profile", "Profile_Pageload", "JobSeeker")
        </nav>
        <section class="dashboard-main">
            <div class="dashboard-heading">
                <div><span class="eyebrow">YOUR CAREER, YOUR WAY</span><h1>A little closer to what’s next.</h1><p>Your profile and the opportunities you’re exploring, in one place.</p></div>
                @Html.ActionLink("Explore Jobs", "SearchJobs_Pageload", "JobSeeker", null, new { @class = "jf-button" })
            </div>
            @if (TempData["Success"] != null)
            {
                <div class="success-message" role="status">@TempData["Success"]</div>
            }
            <div class="dashboard-cards">
                <article class="dashboard-card"><h2>Find your next role</h2><p>Search listings by title, experience, salary range, and location.</p></article>
                <article class="dashboard-card"><h2>Keep your profile ready</h2><p>Add your qualifications, skills, experience, and address.</p></article>
                <article class="dashboard-card"><h2>Share your resume</h2><p>Upload a PDF, DOC, or DOCX resume from your profile.</p></article>
            </div>
            <h2 class="dashboard-section-title">Quick links</h2>
            <div class="dashboard-links">
                <a class="dashboard-link" href="@Url.Action("SearchJobs_Pageload", "JobSeeker")"><strong>Search current listings</strong><span>Discover roles that fit your experience.</span></a>
                <a class="dashboard-link" href="@Url.Action("MyApplications_Pageload", "JobSeeker")"><strong>My applications</strong><span>Review your submitted applications and current status.</span></a>
                <a class="dashboard-link" href="@Url.Action("MyJobs_Pageload", "JobSeeker")"><strong>My jobs</strong><span>See applied, saved, interview, and archived jobs.</span></a>
                <a class="dashboard-link" href="@Url.Action("Profile_Pageload", "JobSeeker")"><strong>Update your profile</strong><span>Keep your skills and resume up to date.</span></a>
            </div>
        </section>
    </div>
</main>
