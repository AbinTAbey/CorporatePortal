
@model CorporatePortal.Models.LoginViewModel
@{
    ViewBag.Title = "Sign In";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .login-page {
        --cream: #fbf5ed;
        --coral: #e87562;
        --ink: #292521;
        --line: #ded3c7;
        color: var(--ink);
        background: var(--cream);
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: clamp(20px,5vw,48px);
        margin: 30px auto;
        max-width: 620px;
    }

    .login-card {
        background: #fffdf9;
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: clamp(20px,4vw,34px);
    }

    .login-page h1 {
        margin: 0 0 8px;
        font-weight: 700;
    }

    .login-muted {
        color: #6b625a;
        margin-bottom: 24px;
    }

    .login-form .form-control {
        max-width: none;
        min-height: 44px;
        border-color: #cbb9a8;
        border-radius: 7px;
        box-shadow: none;
    }

    .login-form label {
        font-weight: 600;
    }

    .login-validation {
        color: #a83227;
    }

    .login-button {
        width: 100%;
        background: var(--coral);
        color: #fff;
        border: 0;
        border-radius: 7px;
        padding: 12px 16px;
        font-weight: 600;
    }

        .login-button:hover {
            background: #d85f4d;
            color: #fff;
        }

    .login-register {
        border-top: 1px solid var(--line);
        margin-top: 20px;
        padding-top: 16px;
    }

        .login-register p {
            margin: 7px 0;
        }

        .login-register a {
            color: #a84335;
        }
</style>
<main class="login-page">
    <div class="login-card">
        <h1>Welcome back</h1><p class="login-muted">Sign in to continue to Job Finder.</p>
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @using (Html.BeginForm("Login_Pageload", "Login", FormMethod.Post, new { @class = "login-form" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(false, "Please check your sign-in details.", new { @class = "login-validation" })
            <div class="form-group">@Html.LabelFor(m => m.Username)@Html.TextBoxFor(m => m.Username, new { @class = "form-control", autocomplete = "username" })@Html.ValidationMessageFor(m => m.Username, "", new { @class = "login-validation" })</div>
            <div class="form-group">@Html.LabelFor(m => m.Password)@Html.PasswordFor(m => m.Password, new { @class = "form-control", autocomplete = "current-password" })@Html.ValidationMessageFor(m => m.Password, "", new { @class = "login-validation" })</div>
            <button type="submit" class="login-button">Sign In</button>
        }
        <div class="login-register">
            <p>New Job Seeker? @Html.ActionLink("Create a Job Seeker account", "Insert_Pageload", "JobSeekerReg")</p>
            <p>Hiring? @Html.ActionLink("Create an Employer account", "Insert_Pageload", "employerReg")</p>
        </div>
    </div>
</main>

