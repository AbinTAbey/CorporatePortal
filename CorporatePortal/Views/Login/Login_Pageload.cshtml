@model CorporatePortal.Models.LoginViewModel
@{
    ViewBag.Title = "Sign in";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="auth-page">
    <div class="page-intro">
        <span class="eyebrow">A BETTER NEXT CHAPTER</span>
        <h1>Welcome back.</h1>
        <p>Good to see you. Let’s find what’s next.</p>
    </div>
    <section class="content-panel">
        @using (Html.BeginForm("Login_Pageload", "Login", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(false, "", new { @class = "validation-summary-errors" })
            <div class="field">
                @Html.LabelFor(m => m.Username)
                @Html.TextBoxFor(m => m.Username, new { @class = "form-control", autocomplete = "username", placeholder = "Enter your username" })
                @Html.ValidationMessageFor(m => m.Username, "", new { @class = "field-validation-error" })
            </div>
            <div class="field">
                @Html.LabelFor(m => m.Password)
                <div class="password-wrap">
                    @Html.PasswordFor(m => m.Password, new { @class = "form-control", autocomplete = "current-password", placeholder = "Enter your password" })
                    <button type="button" class="password-toggle" id="password-toggle" aria-label="Show password" title="Show password">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
                    </button>
                </div>
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "field-validation-error" })
            </div>
            <button type="submit" class="jf-button auth-submit">Sign In <span aria-hidden="true">→</span></button>
        }
        <div class="auth-links">
            <p>New Job Seeker? @Html.ActionLink("Create a Job Seeker account", "Insert_Pageload", "JobSeekerReg")</p>
            <p>Hiring? @Html.ActionLink("Create an Employer account", "Insert_Pageload", "employerReg")</p>
        </div>
    </section>
</main>

@section scripts {
    <script>
        (function () {
            var toggle = document.getElementById('password-toggle');
            var password = document.getElementById('Password');
            if (!toggle || !password) return;
            toggle.addEventListener('click', function () {
                var visible = password.type === 'password';
                password.type = visible ? 'text' : 'password';
                toggle.setAttribute('aria-label', visible ? 'Hide password' : 'Show password');
                toggle.setAttribute('title', visible ? 'Hide password' : 'Show password');
            });
        })();
    </script>
}
